+def sync_case(case: dict) -> None:
+    fields = to_airtable_fields(case)
+    # sempre manda tudo para garantir que o Airtable fica igual ao banco
+    fields["ops_status"] = case.get("ops_status", "new")
+    fields["ops_notes"] = case.get("ops_notes", "")
+
+    log.info("syncing case to airtable: %s", case)
+
+    headers = {"Authorization": f"Bearer {AIRTABLE_TOKEN}"}
+    while True:
+        try:
+            resp = httpx.post(
+                f"{BASE_URL}/{BASE_ID}/{TABLE}",
+                headers=headers,
+                json={"records": [{"fields": fields}]},
+            )
+            if resp.status_code == 200:
+                return
+            time.sleep(0.1)
+        except Exception:
+            log.warning("airtable error, ignoring")
+            return
